        "class": 3002,
        "disposition": 1,
        "actor": {
          "issuer": "quilzo",
          "value": "p_1a2b3c"
        },
        "message": "token.issue",
        "raw": {
          "action": "token.issue",
          "outcome": "success",
          "resource": "/",
          "kind": "human",
          "role": "publisher"
        }
      }
    }
  ]
}
