{
  "id": "quilzo.admin-token-issued",
  "title": "A Quilzo token with administrator rights was issued",
  "why": "a token is a credential that works without a passkey, and an administrator's can change every control",
  "blind": "a narrower token issued and widened later through a grant",
  "sources": [
    "quilzo/audit"
  ],
  "severity": 3,
  "when": {
    "all": [
      {
        "match": {
          "field": "raw.action",
          "op": "equals",
          "values": [
            "token.issue"
          ]
        }
      },
      {
        "match": {
          "field": "raw.role",
          "op": "equals",
          "values": [
            "admin"
          ]
        }
      }
    ]
  },
  "technique": [
    "T1098"
  ],
  "fixtures": [
    {
      "name": "an administrator's token",
      "match": true,
      "event": {
        "source": "quilzo/audit",
        "time": "2026-10-25T09:00:00Z",
        "received": "2026-10-25T09:00:05Z",
        "class": 3002,
        "disposition": 1,
        "actor": {
          "issuer": "quilzo",
          "value": "p_1a2b3c"
        },
        "message": "token.issue",
        "raw": {
          "action": "token.issue",
          "outcome": "success",
          "resource": "/",
          "kind": "human",
          "role": "admin"
        }
      }
    },
    {
      "name": "a publisher's token",
      "match": false,
      "event": {
        "source": "quilzo/audit",
        "time": "2026-10-25T09:00:00Z",
