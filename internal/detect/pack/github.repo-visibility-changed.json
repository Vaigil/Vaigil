        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "github",
          "value": "dana-gh"
        },
        "message": "repo.archived",
        "raw": {
          "action": "repo.archived",
          "repo": "acme/shop",
          "org": "acme",
          "person": "dana@acme.com"
        }
      }
    },
    {
      "name": "a push",
