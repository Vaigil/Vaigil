{
  "id": "snowflake.password-only-login",
  "title": "A Snowflake login used a password with no second factor",
  "why": "every Snowflake tenant the 2024 intruders entered lacked a second factor, and this is the login that says the warehouse is being opened with one",
  "blind": "a password-only service account the tenant means to run that way; that is a suppression, not a pattern",
  "sources": [
    "snowflake/logins"
  ],
  "severity": 4,
  "when": {
    "all": [
      {
        "match": {
          "field": "message",
          "op": "equals",
          "values": [
            "LOGIN"
          ]
        }
      },
      {
        "match": {
          "field": "disposition",
          "op": "equals",
          "values": [
            "allowed"
          ]
        }
      },
      {
        "match": {
          "field": "raw.FIRST_AUTHENTICATION_FACTOR",
          "op": "equals",
          "values": [
            "PASSWORD"
          ]
        }
      },
      {
        "any": [
          {
            "not": {
              "match": {
                "field": "raw.SECOND_AUTHENTICATION_FACTOR",
                "op": "exists"
              }
            }
          },
          {
            "match": {
              "field": "raw.SECOND_AUTHENTICATION_FACTOR",
              "op": "equals",
              "values": [
                "NONE"
              ]
            }
          }
        ]
      }
    ]
  },
  "technique": [
    "T1078.004",
    "T1110"
  ],
  "fixtures": [
    {
      "name": "a password-only success",
      "match": true,
      "event": {
        "source": "snowflake/logins",
        "time": "2026-09-01T00:00:00Z",
        "received": "2026-09-01T00:00:05Z",
        "class": 3002,
        "disposition": 1,
        "actor": {
          "issuer": "snowflake",
          "value": "DANA"
        },
        "message": "LOGIN",
        "raw": {
          "IS_SUCCESS": "YES",
          "FIRST_AUTHENTICATION_FACTOR": "PASSWORD",
          "REPORTED_CLIENT_TYPE": "JDBC"
        }
      }
    },
    {
      "name": "a password with a second factor",
      "match": false,
      "event": {
        "source": "snowflake/logins",
        "time": "2026-09-01T00:00:00Z",
        "received": "2026-09-01T00:00:05Z",
        "class": 3002,
        "disposition": 1,
        "actor": {
          "issuer": "snowflake",
          "value": "DANA"
        },
        "message": "LOGIN",
        "raw": {
          "IS_SUCCESS": "YES",
          "FIRST_AUTHENTICATION_FACTOR": "PASSWORD",
          "SECOND_AUTHENTICATION_FACTOR": "OKTA",
          "REPORTED_CLIENT_TYPE": "JDBC"
        }
      }
    },
    {
      "name": "a failed password-only attempt",
      "match": false,
      "event": {
        "source": "snowflake/logins",
        "time": "2026-09-01T00:00:00Z",
        "received": "2026-09-01T00:00:05Z",
        "class": 3002,
        "disposition": 4,
        "actor": {
          "issuer": "snowflake",
          "value": "DANA"
        },
        "message": "LOGIN",
        "raw": {
          "IS_SUCCESS": "NO",
          "FIRST_AUTHENTICATION_FACTOR": "PASSWORD",
          "ERROR_MESSAGE": "INCORRECT_USER_NAME_OR_PASSWORD",
          "REPORTED_CLIENT_TYPE": "JDBC"
        }
      }
    }
  ]
}
