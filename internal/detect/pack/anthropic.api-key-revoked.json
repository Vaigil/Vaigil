{
  "id": "anthropic.api-key-revoked",
  "title": "An API or admin key was revoked in the Claude organisation",
  "why": "revocation is hygiene after compromise or rotation, and it is also the compliance feed losing an eye: whichever key went away stops reporting the activities this rule reads, and an admin key deleted by anybody other than the owner is worth a question. The closed value list is deliberate — the feed names hundreds of *_revoked types, and only key material belongs in a rule that claims to be about keys",
  "blind": "claude_code_credential_revoked, the agent CLI's own credential, which the feed names separately and this rule deliberately does not count; a revocation is not a threat by itself, and widening the list to every revoked type would bury the key material in consent and share revocations",
  "sources": [
    "anthropic/audit"
  ],
  "severity": 3,
  "when": {
    "match": {
      "field": "message",
      "op": "equals",
      "values": [
        "scoped_api_key_deleted",
        "admin_api_key_deleted",
        "service_key_revoked"
      ]
    }
  },
  "technique": [
    "T1531"
  ],
