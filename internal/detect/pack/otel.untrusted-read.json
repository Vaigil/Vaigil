{
  "id": "otel.untrusted-read",
  "title": "An agent read untrusted content",
  "why": "the first leg of the lethal trifecta (catalogue B2): a tool call that returned text nobody in the organisation wrote — a fetched page, a search result, an issue body, inbound mail. The label is declared, not inferred: it arrived at the ingest boundary from the tool-label table, which names this tool as one that reads the open web. Quiet on purpose — one untrusted read is an agent doing its job; what the correlation over this leg and the two beside it counts is the sequence",
  "blind": "every tool the table does not name — an unlabelled fetcher joins nothing, and the table is a declaration that can lag a tool rename; the content itself, which the boundary drops keeping only lengths; and the call's arguments, which are never carried at all",
  "sources": [
    "otel/genai"
  ],
  "severity": 2,
  "when": {
    "all": [
      {
        "match": {
          "field": "message",
          "op": "equals",
          "values": [
            "execute_tool"
          ]
        }
      },
      {
        "match": {
          "field": "raw.labels",
          "op": "contains",
          "values": [
            "untrusted-content"
          ]
        }
      }
    ]
  },
  "technique": [
    "AML.T0051.001",
    "ASI01"
  ],
  "quiet": true,
  "fixtures": [
    {
      "name": "a call to the table's fetch tool",
      "match": true,
      "event": {
        "source": "otel/genai",
        "time": "2026-10-27T03:20:00Z",
        "received": "2026-10-27T03:20:05Z",
        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "otel",
          "value": "refunder"
        },
        "message": "execute_tool",
        "raw": {
          "operation": "execute_tool",
          "tool": "fetch",
          "status": "ok",
          "trace_id": "5b8efff798038103d269b633813fc60c",
          "labels": "untrusted-content"
        }
      }
    },
    {
      "name": "a mail read, which carries two labels",
      "match": true,
      "event": {
        "source": "otel/genai",
