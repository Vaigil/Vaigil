{
  "id": "vaigil.agent-proposed",
  "title": "A model proposed what to do with a finding",
  "why": "a stream of these from one actor is either an assistant at work or one running away, and the correlation over this is the rate. Counted by a correlation, and raises nothing itself",
  "blind": "proposals made anywhere but the audit log, and the abstentions, which are a model declining to propose",
  "sources": [
    "vaigil/agent"
  ],
  "severity": 2,
  "when": {
    "match": {
      "field": "raw.action",
      "op": "equals",
      "values": [
        "proposal.finding"
      ]
    }
  },
  "quiet": true,
  "fixtures": [
    {
      "name": "a proposal to close a finding",
      "match": true,
      "event": {
        "source": "vaigil/agent",
        "time": "2026-10-01T09:00:00Z",
