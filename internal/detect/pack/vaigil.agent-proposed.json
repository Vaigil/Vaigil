        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "vaigil",
          "value": "analyst:triage"
        },
        "message": "proposal.finding",
        "raw": {
          "action": "proposal.finding",
          "outcome": "success",
          "resource": "/f_104",
          "model": "gpt-oss:20b",
          "finding": "f_104",
          "agent": "triage",
          "to": "benign",
          "confidence": "0.80"
        }
      }
    },
    {
      "name": "the analyst abstained",
      "match": false,
      "event": {
        "source": "vaigil/agent",
        "time": "2026-10-01T09:00:00Z",
        "received": "2026-10-01T09:00:05Z",
        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "vaigil",
          "value": "analyst:triage"
        },
        "message": "analyst.abstained",
        "raw": {
          "action": "analyst.abstained",
          "outcome": "success",
          "resource": "/f_104",
          "model": "gpt-oss:20b",
          "finding": "f_104",
