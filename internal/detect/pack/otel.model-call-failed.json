{
  "id": "otel.model-call-failed",
  "title": "An agent's model call failed",
  "why": "one failed model call is the ordinary friction of the model plane; a streak from one agent is a dead key, a broken deployment or a loop that will not take the model's answer, and the correlation over this counts the streak. Counted by a correlation, and raises nothing itself",
  "blind": "why it failed — the span carries a status, not the model's error — and failures whose SDK names the operation anything other than invoke_model or invoke_chat_model",
  "sources": [
    "otel/genai"
  ],
  "severity": 2,
  "when": {
    "all": [
      {
        "match": {
          "field": "message",
          "op": "equals",
          "values": [
            "invoke_model",
            "invoke_chat_model"
          ]
        }
      },
      {
        "match": {
          "field": "disposition",
          "op": "equals",
          "values": [
            "failed"
          ]
        }
      }
    ]
  },
  "technique": [
    "ASI08"
  ],
  "quiet": true,
  "fixtures": [
    {
      "name": "a model call that errored",
      "match": true,
