{
  "id": "aws.backup-deleted",
  "title": "A backup or snapshot was deleted",
  "why": "deleting the backups is the minutes-before-ransomware move, made to deny the recovery nobody has tested",
  "blind": "a retention job doing exactly its job; the backup role's arn belongs in a suppression, not in this rule",
  "sources": [
    "aws/cloudtrail"
  ],
  "severity": 5,
  "when": {
    "match": {
      "field": "message",
      "op": "equals",
      "values": [
        "DeleteSnapshot",
        "DeleteBackupSelection",
        "DeleteRecoveryPoint"
      ]
    }
  },
  "technique": [
    "T1490",
    "T1485"
  ],
  "fixtures": [
