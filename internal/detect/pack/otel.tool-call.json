{
  "id": "otel.tool-call",
  "title": "An agent called a tool",
  "why": "one tool call is an agent working; the finding is the rate, which the correlation over this counts — the runaway loops it exists for (catalogue B13) run at several calls a second where supervised work has gaps. Counted by a correlation, and raises nothing itself",
  "blind": "everything the tool did — the span carries the tool's name and never its arguments, which are hashed upstream at best — and the calls of an SDK that set no gen_ai.operation.name and whose span name is not execute_tool",
  "sources": [
    "otel/genai"
  ],
  "severity": 2,
  "when": {
    "match": {
      "field": "message",
      "op": "equals",
      "values": [
        "execute_tool"
      ]
    }
  },
  "technique": [
    "LLM10",
    "ASI08"
  ],
  "quiet": true,
