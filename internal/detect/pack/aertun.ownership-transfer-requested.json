{
  "id": "aertun.ownership-transfer-requested",
  "title": "Somebody asked for ownership of aertun to move",
  "why": "ownership is the one access nobody else can take away, and a transfer waits a day so the Owner can see the request and decline it; a stolen Owner session that wants the store for good starts here",
  "blind": "an Owner who confirms a transfer they did not mean to ask for, and changes made on the machine itself, outside aertun",
  "sources": [
    "aertun/audit"
  ],
  "severity": 4,
  "when": {
    "all": [
      {
        "match": {
          "field": "raw.action",
          "op": "equals",
          "values": [
            "dual.proposed"
          ]
        }
      },
      {
        "match": {
          "field": "raw.kind",
          "op": "equals",
          "values": [
            "owner"
          ]
        }
      }
    ]
  },
  "technique": [
    "T1098"
  ],
