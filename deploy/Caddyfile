# The console over https, with a certificate Caddy gets and renews itself.
#
#   caddy run --config deploy/Caddyfile
#
# Replace the hostname, and tell aertun it is behind TLS:
#
#   aertun config set admin.behind_tls_proxy true
#   aertun config set admin.base_url https://aertun.example.com
#   aertun config set admin.trusted_proxy true

aertun.example.com {
	reverse_proxy 127.0.0.1:8080
	encode zstd gzip
}
