# The console over https, with a certificate Caddy gets and renews itself.
#
#   caddy run --config deploy/Caddyfile
#
# Replace the hostname, and tell Vaigil it is behind TLS:
#
#   vaigil config set admin.behind_tls_proxy true
#   vaigil config set admin.base_url https://vaigil.example.com
#   vaigil config set admin.trusted_proxy true

vaigil.example.com {
	reverse_proxy 127.0.0.1:8080
	encode zstd gzip
}
