# The console over https, with a certificate Caddy gets and renews itself.
#
#   caddy run --config deploy/Caddyfile
#
# Replace the hostname, and tell AeroProve it is behind TLS:
#
#   aeroprove config set admin.behind_tls_proxy true
#   aeroprove config set admin.base_url https://aeroprove.example.com
#   aeroprove config set admin.trusted_proxy true

aeroprove.example.com {
	reverse_proxy 127.0.0.1:8080
	encode zstd gzip
}
