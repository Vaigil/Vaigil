# The console, the feeds other systems push to, and the scheduled work.
#
#   sudo cp deploy/aeroprove.service /etc/systemd/system/
#   sudo systemctl enable --now aeroprove
#
# A key for the keyring, when one is enabled, comes from outside the store:
# put AEROPROVE_KEY_FILE (or AEROPROVE_KEY_COMMAND) in /etc/aeroprove/env, readable
# by root alone.

[Unit]
Description=AeroProve security operations console
Documentation=https://aeroprove.github.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aeroprove
Group=aeroprove
WorkingDirectory=/srv/aeroprove
EnvironmentFile=-/etc/aeroprove/env

ExecStart=/usr/local/bin/aeroprove --root /srv/aeroprove/store serve --addr 127.0.0.1:8080

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# The store is the only place it writes.
ReadWritePaths=/srv/aeroprove/store

[Install]
WantedBy=multi-user.target
